NEXT_PUBLIC_APP_URL=http://localhost:8888

# JWT 签名密钥（最少32字符，生产环境请使用强密码）

# 生成建议: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production-minimum-32-chars

# resend 邮箱配置
RESEND_API_KEY=re_xxxx

# 发送邮件的邮箱
EMAIL_FROM=notify@mahirooyama.cn
# 管理员默认密码
ADMIN_DEFAULT_PASSWORD=xxx
# DeepSeek API 密钥
DEEPSEEK_API_KEY=your_key_here
# openrouter API 密钥
OPENROUTER_API_KEY=your_key_here
# openrouter 时指定具体模型
OPENROUTER_MODEL=openai/gpt-oss-20b:free
