# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:8888

# -----------------------------------------------------------------------------
# Admin Authentication (24h session with enhanced security)
# -----------------------------------------------------------------------------

# JWT 签名密钥（最少32字符，生产环境请使用强密码）
# 生成建议: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production-minimum-32-chars

RESEND_API_KEY=xxxx
EMAIL_FROM=xxxx
# 会话配置
# SESSION_EXPIRY=86400  # 24小时（秒），默认
# RATE_LIMIT_WINDOW_MS=300000  # 5分钟（毫秒），默认
# RATE_LIMIT_MAX=5  # 登录尝试次数，默认

# Cookie secure 属性（HTTP部署需设置为 false）
# 默认为 true（当 NODE_ENV=production 时）
# 如果你的云服务器使用 HTTP 而非 HTTPS，请设置为 false
# COOKIE_SECURE=false

