# Nginx 反向代理配置示例
# 部署到服务器 /etc/nginx/sites-available/mahirooyama.conf
# 然后 ln -s /etc/nginx/sites-available/mahirooyama.conf /etc/nginx/sites-enabled/
#
# 架构：用户 → nginx (HTTPS) → 容器群
#   - example.com/cn/... → next-frontend:3000
#   - example.com/api/movies → backend-go:8080
#   - 容器间 Server Action 调用走 docker 内网，不经过 nginx

server {
    listen 80;
    server_name example.com www.example.com;
    # HTTP 全部重定向到 HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name example.com www.example.com;

    # SSL 证书路径（用 certbot 申请：certbot --nginx -d example.com -d www.example.com）
    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # 上传文件大小限制（按需调整，电影海报/图片上传用）
    client_max_body_size 20M;

    # 关键：/api/* 直接路由到 Go 后端，绕过 Next.js
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 传递内部密钥（Server Action 转发场景已带，浏览器直调场景 nginx 补上）
        proxy_set_header X-Internal-Secret $http_x_internal_secret;
    }

    # Next.js 静态资源（_next/static 长缓存）
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_cache_valid 200 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # 其他所有路径走 Next.js
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Next.js 14+ WebSocket（HMR 等用，生产可保留）
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
